{
  "expo": {
    "name": "mott",
    "slug": "mott",
    "version": "0.5.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "dev.mott.app"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir a mott escanear el código QR de la PC.",
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
